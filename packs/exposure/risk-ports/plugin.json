{
  "name": "risk-ports",
  "description": "Flag well-known high-risk open ports as info findings (observe-only)",
  "version": "0.1.0",
  "capabilities": ["passive", "misconfig"],
  "categories": ["safe", "exposure"],
  "emit": "ndjson",
  "default_ports": [],
  "timeout_secs": 10,
  "protocol": "tcp",
  "command": "powershell -NoProfile -File run.ps1",
  "command_windows": "powershell -NoProfile -File run.ps1",
  "command_unix": "sh run.sh"
}
